# Drop-injection active-learning defaults.
# Values here are used by end-to-end-with-visualization-drop-injection.py.
# Command-line flags override these values.

seed = 11
iterations = 120
initial_points = 20
batch_size = 16
n_new = auto
n_repeats = 3

# Parameter-space bounds from the drop-injection regime map.
rr_min = 1
rr_max = 100
rr_scale = log10
oh_min = 0.001
oh_max = 0.1
oh_scale = log10

# Proposal model and display-performance controls.
# posterior_samples = 0 is the fast interactive visualizer setting.
# Increase it when uncertainty bands matter more than run speed.
grid_size = 15
posterior_samples = 0
length_scale_x = 0.18
length_scale_y = auto
preview_points = 120
preview_grid_size = 61
preview_every = 10
preview_posterior_samples = 0
delay = 0.04
